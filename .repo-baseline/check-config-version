#!/usr/bin/env bash
# Managed by repo-baseline; baseline-version: 1
set -euo pipefail

repo_version="$(sed -n 's/^# baseline-version: //p' .gitleaks.toml | head -n 1)"
if [[ -z "$repo_version" ]]; then
  printf '%s\n' "repo-baseline: .gitleaks.toml has no baseline version" >&2
  exit 1
fi

skill_dir="${REPO_BASELINE_SKILL_DIR:-$HOME/.claude/skills/repo-baseline}"
master="$skill_dir/assets/gitleaks.toml"
if [[ ! -r "$master" ]]; then
  exit 0
fi

master_version="$(sed -n 's/^# baseline-version: //p' "$master" | head -n 1)"
if [[ "$repo_version" != "$master_version" ]]; then
  printf '%s\n' \
    "repo-baseline: config v${repo_version} is stale; run repo_baseline.py sync-config (current v${master_version})" >&2
  exit 1
fi
